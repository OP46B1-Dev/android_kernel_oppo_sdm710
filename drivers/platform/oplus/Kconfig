# OPlus configuration options

config MACH_OPLUS
	bool "OPlus device"
	depends on ARCH_QCOM
	help
	  Support for OPlus products

config MACH_OPLUS_SDM710
	bool "OPlus SDM710"
	depends on ARCH_QCOM
	select MACH_OPLUS
	help
	  Support for OPlus SDM710 devices

menu "OPlus board selection"

config MACH_OPLUS_OP46B1
  bool "OPPO Reno board"
  select MACH_OPLUS_SDM710
  help
    Support for OPPO Reno (OP46B1)

endmenu
