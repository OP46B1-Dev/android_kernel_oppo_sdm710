# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Fingerprint
CONFIG_OPPO_FINGERPRINT_GOODIX_OPTICAL=y

# Haptics
CONFIG_TOUCHSCREEN_SYNAPTICS=y
CONFIG_TOUCHSCREEN_SYNAPTICS_S3706=y

# Motor
CONFIG_OPPO_MOTOR=y
CONFIG_MOTOR_DETECT_QOS=y
CONFIG_MOTOR_CLASS_INTERFACE=y

# NFC
CONFIG_OPLUS_NFC=y
CONFIG_NFC_PN553_DEVICES=y
CONFIG_NXP_P73_DEVICES=y

# Platform
CONFIG_MACH_OPLUS_OP46B1=y
