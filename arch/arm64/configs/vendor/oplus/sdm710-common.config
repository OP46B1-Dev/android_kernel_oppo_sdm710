# Auto local version
CONFIG_LOCALVERSION_AUTO=y

# Crypto
CONFIG_CRYPTO_LZ4=y

# Filesystems
CONFIG_EXFAT_FS=y

# Fingerprint
CONFIG_OPPO_FINGERPRINT=y
CONFIG_OPPO_FINGERPRINT_QCOM=y

# Haptics
# CONFIG_INPUT_HBTP_INPUT is not set
CONFIG_TOUCHSCREEN_OPLUS=y

# OPlus
CONFIG_OPLUS_DEVICE_INFO=y
CONFIG_OPLUS_FEATURE_OPROJECT=y
CONFIG_OPLUS_FEATURE_PROJECTINFO=y
CONFIG_OPLUS_FEATURE_RECORD_MDMRST=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# Ramdisk
CONFIG_RD_LZ4=y
